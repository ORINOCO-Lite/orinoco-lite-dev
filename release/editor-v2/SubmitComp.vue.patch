+async function uploadReviewBundle(event) {
+    const file = event.target.files?.[0];
+    event.target.value = '';
+    if (!file) return;
+    reviewBundleStatus.value = null;
+    try {
+        if (file.size > 10 * 1024 * 1024) {
+            throw new Error('review bundle exceeds 10 MiB');
+        }
+        const restored = restoreReviewBundle({
+            bundle: JSON.parse(await file.text()),
+            catalog: await loadRecordCatalog(),
+            graph: rdfDS.data.graph,
+            prefixes: allPrefixes,
+        });
+        for (const record of restored) {
+            const existing = nodesToSubmit.value.findIndex(
+                (node) => node.node_iri === record.node_iri
+            );
+            if (existing < 0) nodesToSubmit.value.push(record);
+            else nodesToSubmit.value.splice(existing, 1, record);
+        }
+        selectedNodesToSubmit.value = [
+            ...new Set([
+                ...selectedNodesToSubmit.value,
+                ...restored.map((record) => record.node_iri),
+            ]),
+        ];
+        reviewBundleStatus.value = {
+            message: `Restored ${restored.length} edited record${restored.length === 1 ? '' : 's'} from the review bundle.`,
+            type: 'success',
+        };
+    } catch (error) {
+        reviewBundleStatus.value = {
+            message: `The review bundle could not be uploaded: ${error.message}`,
+            type: 'error',
+        };
+    }
